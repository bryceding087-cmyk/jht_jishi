# Production database. Keep the real .env outside version control.
# Run scripts/setup_local_postgres.ps1 for a local Windows instance.
JIANHUITONG_DATABASE_URL=postgresql+psycopg://jianhuitong:REPLACE_WITH_PASSWORD@127.0.0.1:55432/jianhuitong
HOST=127.0.0.1
PORT=8000
# Browser-facing application origin behind the HTTPS reverse proxy.
# Empty disables the proxy-origin exception. This is NOT the marketplace parent.
JIANHUITONG_PUBLIC_ORIGIN=https://aimarket.hncig.cn:4193

# Explicit trusted parent origin; this matches the supplied url-agent example.
# Change only the parent origin if the marketplace UI uses another port/domain.
JIANHUITONG_MARKET_ORIGIN=https://aimarket.hncig.cn:4090
# Local model gateway; Docker defaults to http://192.168.241.202:4091.
# API paths include /v1. Do not copy the local .env into the Docker image.
JIANHUITONG_MARKET_MODEL_ORIGIN=https://aimarket.hncig.cn:4090
JIANHUITONG_MARKET_AGENT_ID=020884f4-99f0-4d6f-bbc4-74426e6fed1c
# Trusted SDK context login: use platform user.id for personal workspaces.
JIANHUITONG_MARKET_SDK_LOGIN=1
JIANHUITONG_MARKET_KEY_TTL=3600
# Optional standalone gateway key. /market always uses the SDK session key.
JIANHUITONG_MARKET_API_KEY=
# Seed Audio uses this server-only key with X-Api-Key, including in /market.
SEEDAUDIO_API_KEY=
# Local password-login cookie policy. SDK login uses page tokens, not cookies.
JIANHUITONG_COOKIE_SAMESITE=lax
